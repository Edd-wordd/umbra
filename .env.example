# TypeSafe System One (Jev) — the decision layer. Server-only: read by
# src/app/api/decide/route.ts, never sent to the browser. Copy to .env.local.
# Without a key, Umbra uses its local heuristic (source "local").
TYPESAFE_API_KEY=
# Optional overrides
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Umbra Mac helper (helper/). `pnpm helper` prints both lines on first run
# (again any time: `pnpm helper --print-env`). Server-only: the browser gets
# short-lived socket tickets, never the token. Leave empty = sample data.
UMBRA_HELPER_URL=
UMBRA_HELPER_TOKEN=
