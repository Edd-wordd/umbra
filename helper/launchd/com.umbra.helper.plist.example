<?xml version="1.0" encoding="UTF-8"?>
<!--
  Start the Umbra Mac helper at login (launchd LaunchAgent), so pings work
  without a terminal open.

    pnpm helper:install-login     builds helper/dist, fills in the @…@ values below,
                                  writes ~/Library/LaunchAgents/com.umbra.helper.plist
                                  and runs `launchctl bootstrap gui/$UID` on it
    pnpm helper:uninstall-login   `launchctl bootout` + removes the plist

  @NODE@      the node that ran the install (nvm: rerun the install after switching versions)
  @REPO@      this repo's absolute path
  @HOME@      your home folder
  @PATH@      ~/.local/bin (herdr) : /usr/local/bin (Intel Homebrew: gh, terminal-notifier)
              : /opt/homebrew/bin (Apple Silicon Homebrew) : node's bin dir : system dirs
              (launchd starts with a bare PATH; lsof lives in /usr/sbin)
  Logs: ~/Library/Logs/umbra-helper.log (stdout + stderr). After pulling changes:
  pnpm helper:install-login again (rebuilds and restarts it).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.umbra.helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@REPO@/helper/dist/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/umbra-helper.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/umbra-helper.log</string>
</dict>
</plist>
